# Dependencies (rebuilt in container for correct platform)
node_modules/
npm-debug.log*

# Environment secrets (passed via env_file at runtime)
.env
.env.*

# Persistent data (volume-mounted at runtime)
src/data/*.db
src/data/*.db-shm
src/data/*.db-wal
src/data/reports/
src/data/ws-restart-state.json

# Git history (not needed in image)
.git/

# IDE / OS
.idea/
.vscode/
*.swp
*.swo
.DS_Store

# Temp / build
tmp/
temp/
dist/
build/
coverage/

# Dev-only
docs/plans/
.serena/
