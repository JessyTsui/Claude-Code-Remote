# Claude Code Remote Configuration — Slack + Tmux Only
# Copy this file to .env and configure with your actual values

# ===== Slack Configuration =====
# Uses Socket Mode (no public URL required)

# Bot Token (from Slack App settings page, starts with xoxb-)
# SLACK_BOT_TOKEN=xoxb-your-bot-token

# App-Level Token (from Slack App > Basic Information > App-Level Tokens, starts with xapp-)
# Requires connections:write scope
# SLACK_APP_TOKEN=xapp-your-app-token

# Channel ID to send notifications to
# SLACK_CHANNEL_ID=C0123456789

# Claude working directory (starts Claude in this directory when a message is received)
# SLACK_REPO_PATH=/Users/you/your-project

# Root directory for project discovery (used with "start claude in project XXX from root")
# When set, you can say "start claude in project payments from root" and it will
# start Claude in SLACK_REPO_ROOT/payments
# SLACK_REPO_ROOT=/Users/you/projects

# Custom Claude launch command (optional)
# SLACK_CLAUDE_COMMAND=claude --dangerously-skip-permissions

# Authorized user whitelist (Slack User IDs, comma-separated, empty = all users allowed)
# SLACK_WHITELIST=U0123456789,U9876543210

# HTTP API port for health check, Swagger docs, and management endpoints (default: 9999)
# Swagger UI: http://localhost:9999/docs
# SLACK_HTTP_PORT=9999

# ===== Alert Monitoring Configuration =====
# Channels to watch for PagerDuty alerts (comma-separated names, prefix ! to exclude)
# Example: alerts,incidents,!staging-alerts
# MONITOR_CHANNELS=payments-alerts

# Claude skill/prompt to use for alert investigation
# ALERT_SKILL=one:pay-ops-production

# PagerDuty API authentication (for auto-acknowledge)
# PAGERDUTY_API_TOKEN=your-pagerduty-api-token
# PAGERDUTY_FROM_EMAIL=your-email@company.com

# How long to wait for owner follow-up after investigation (ms, default: 300000 = 5 min)
# ALERT_FEEDBACK_TIMEOUT_MS=300000

# Daily restart hour (0-23, local time). Set to auto-restart the Slack socket server daily.
# Helps maintain a clean connection state. Leave empty to disable.
# DAILY_RESTART_HOUR=23

# ===== System Configuration =====
INJECTION_MODE=tmux
LOG_LEVEL=info

# Session map file path
# SESSION_MAP_PATH=/path/to/your/project/src/data/session-map.json
