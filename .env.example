# Claude Code Remote Configuration
# Copy this file to .env and configure with your actual values

# ===== Notification Channels: Email, LINE, Telegram, or Slack =====
# You can enable multiple channels simultaneously
EMAIL_ENABLED=false
LINE_ENABLED=false
TELEGRAM_ENABLED=false
SLACK_ENABLED=true

# ===== Email Configuration (if using Email) =====
# SMTP outgoing mail configuration
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password

# Sender info (optional, defaults to SMTP_USER)
EMAIL_FROM=your-email@gmail.com
EMAIL_FROM_NAME=Claude Code Remote

# IMAP incoming mail configuration
IMAP_HOST=imap.gmail.com
IMAP_PORT=993
IMAP_SECURE=true
IMAP_USER=your-email@gmail.com
IMAP_PASS=your-app-password

# Email routing
# Recipient email address for notifications
EMAIL_TO=your-email@gmail.com

# Allowed sender addresses for commands (security whitelist)
ALLOWED_SENDERS=your-email@gmail.com

# ===== LINE Configuration (if using LINE) =====
# Get from LINE Developers Console: https://developers.line.biz/
LINE_CHANNEL_ACCESS_TOKEN=your-line-channel-access-token
LINE_CHANNEL_SECRET=your-line-channel-secret

# LINE recipient configuration (set one or both)
# LINE_USER_ID=your-line-user-id
# LINE_GROUP_ID=your-line-group-id

# LINE whitelist (comma-separated user/group IDs)
# If not set, only configured USER_ID/GROUP_ID can use the bot
# LINE_WHITELIST=U1234567890abcdef,C1234567890abcdef

# LINE webhook port (default: 3000)
# LINE_WEBHOOK_PORT=3000

# ===== Telegram Configuration (if using Telegram) =====
# Get Bot Token from @BotFather
TELEGRAM_BOT_TOKEN=your-telegram-bot-token

# Telegram recipient configuration (set one or both)
# Personal chat ID
# TELEGRAM_CHAT_ID=123456789
# Group ID (usually negative)
# TELEGRAM_GROUP_ID=-1001234567890

# Telegram whitelist (comma-separated Chat IDs)
# If not set, only configured CHAT_ID/GROUP_ID can use the bot
# TELEGRAM_WHITELIST=123456789,-1001234567890

# Telegram webhook port (default: 3001)
# TELEGRAM_WEBHOOK_PORT=3001

# Telegram webhook URL (your public HTTPS URL)
# TELEGRAM_WEBHOOK_URL=https://your-domain.com

# Force IPv4 for Telegram API connections (default: false)
# Some networks have unstable IPv6; set to true to force IPv4
# TELEGRAM_FORCE_IPV4=false

# ===== Slack Configuration (if using Slack) =====
# Uses Socket Mode (no public URL required)

# Bot Token (from Slack App settings page, starts with xoxb-)
# SLACK_BOT_TOKEN=xoxb-your-bot-token

# App-Level Token (from Slack App > Basic Information > App-Level Tokens, starts with xapp-)
# Requires connections:write scope
# SLACK_APP_TOKEN=xapp-your-app-token

# Channel ID to send notifications to
# SLACK_CHANNEL_ID=C0123456789

# Claude working directory (starts Claude in this directory when a message is received)
# SLACK_REPO_PATH=/Users/you/your-project

# Root directory for project discovery (used with "start claude in project XXX from root")
# When set, you can say "start claude in project payments from root" and it will
# start Claude in SLACK_REPO_ROOT/payments
# SLACK_REPO_ROOT=/Users/you/projects

# Custom Claude launch command (optional)
# SLACK_CLAUDE_COMMAND=claude --dangerously-skip-permissions

# Authorized user whitelist (Slack User IDs, comma-separated, empty = all users allowed)
# SLACK_WHITELIST=U0123456789,U9876543210

# HTTP API port for health check, Swagger docs, and management endpoints (default: 9999)
# Swagger UI: http://localhost:9999/docs
# SLACK_HTTP_PORT=9999

# ===== Alert Monitoring Configuration =====
# Channels to watch for PagerDuty alerts (comma-separated names, prefix ! to exclude)
# Example: alerts,incidents,!staging-alerts
# MONITOR_CHANNELS=payments-alerts

# Claude skill/prompt to use for alert investigation
# ALERT_SKILL=one:pay-ops-production

# PagerDuty API authentication (for auto-acknowledge)
# PAGERDUTY_API_TOKEN=your-pagerduty-api-token
# PAGERDUTY_FROM_EMAIL=your-email@company.com

# How long to wait for owner follow-up after investigation (ms, default: 300000 = 5 min)
# ALERT_FEEDBACK_TIMEOUT_MS=300000

# Daily restart hour (0-23, local time). Set to auto-restart the Slack socket server daily.
# Helps maintain a clean connection state. Leave empty to disable.
# DAILY_RESTART_HOUR=23

# ===== System Configuration =====
# Session map file path
SESSION_MAP_PATH=/path/to/your/project/src/data/session-map.json

# Run mode: pty or tmux (default: pty, no tmux required)
INJECTION_MODE=pty

# Claude CLI path (optional, defaults to claude in system PATH)
CLAUDE_CLI_PATH=claude

# Log level: debug, info, warn, error
LOG_LEVEL=info

# Whether to log PTY output (for debugging)
PTY_OUTPUT_LOG=false

# ===== Timeout Configuration =====
# Command execution timeout (milliseconds)
COMMAND_TIMEOUT=10000

# SMTP connection timeout (milliseconds)
SMTP_TIMEOUT=10000

# Notification timeout (milliseconds)
NOTIFICATION_TIMEOUT=3000

# Notification display time (milliseconds)
NOTIFICATION_DISPLAY_TIME=10000

# ===== Email Template Configuration =====
# Email check interval (seconds)
CHECK_INTERVAL=20

# Session timeout (hours)
SESSION_TIMEOUT=24

# ===== Test Configuration (optional) =====
# Fixed token for test emails (optional, defaults to dynamic generation)
TEST_TOKEN=

# Gmail app password (for test scripts, optional)
GMAIL_APP_PASSWORD=

# ===== Gmail Setup Instructions =====
# 1. Enable 2FA: https://myaccount.google.com/security
# 2. Generate app password: https://myaccount.google.com/apppasswords
# 3. Enter the 16-character password in SMTP_PASS and IMAP_PASS
# 4. Ensure SMTP_PORT=465 and SMTP_SECURE=true (recommended SSL)

# ===== Other Email Provider Examples =====
# Outlook:
# SMTP_HOST=smtp.live.com
# SMTP_PORT=587
# IMAP_HOST=imap-mail.outlook.com
# IMAP_PORT=993
